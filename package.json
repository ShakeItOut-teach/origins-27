{
  "name": "origins-27",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/client",
    "dev": "node packages/client/node_modules/vite/bin/vite.js packages/client",
    "build": "node packages/client/node_modules/vite/bin/vite.js build packages/client",
    "boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test",
    "hooks": "lefthook install",
    "server:bundle": "node scripts/bundle-server.cjs",
    "server:try": "node scripts/try-function.cjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.11.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
